{
  "type": "object",
  "description": "Weekly or monthly big-picture summary.",
  "properties": {
    "title": { "type": "string" },
    "body": { "type": "string", "description": "Weekly 800-1200 words, monthly 1200-1500 words." },
    "takeaways": { "type": "array", "description": "Exactly 3 things worth remembering.", "items": { "type": "string" } },
    "race_map": {
      "type": "array",
      "description": "Who leads in which area.",
      "items": {
        "type": "object",
        "properties": {
          "area": { "type": "string" },
          "leader": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["area", "leader", "note"],
        "additionalProperties": false
      }
    }
  },
  "required": ["title", "body", "takeaways", "race_map"],
  "additionalProperties": false
}
