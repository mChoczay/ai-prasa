{
  "type": "object",
  "description": "Weekly or monthly big-picture summary.",
  "properties": {
    "title": { "type": "string" },
    "body": { "type": "string", "description": "Weekly 450-650 words, monthly 800-1000 words, in 3-4 parts, each opening with a subhead paragraph that starts with '## '." },
    "takeaways": { "type": "array", "description": "Exactly 3 things worth remembering, one sentence each.", "items": { "type": "string" } },
    "race_map": {
      "type": "array",
      "description": "Who leads in which area, at most 6 rows.",
      "items": {
        "type": "object",
        "properties": {
          "area": { "type": "string" },
          "leader": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["area", "leader", "note"],
        "additionalProperties": false
      }
    }
  },
  "required": ["title", "body", "takeaways", "race_map"],
  "additionalProperties": false
}
