{
  "type": "object",
  "description": "Today's texts after editing: every story by idx and every supplement by kind.",
  "properties": {
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "idx": { "type": "integer", "description": "The story's idx from the input." },
          "lede": { "type": "string", "description": "At most 2 short sentences, readable on its own under the title." },
          "body": { "type": "string", "description": "Paragraphs of 2-4 sentences separated by a blank line." },
          "for_you": { "type": "string", "description": "1-3 sentences." }
        },
        "required": ["idx", "lede", "body", "for_you"],
        "additionalProperties": false
      }
    },
    "supplements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": { "type": "string", "enum": ["weekly", "monthly"] },
          "title": { "type": "string" },
          "body": { "type": "string", "description": "Parts opened by subhead paragraphs that start with '## '." },
          "takeaways": { "type": "array", "description": "As many as given.", "items": { "type": "string" } }
        },
        "required": ["kind", "title", "body", "takeaways"],
        "additionalProperties": false
      }
    }
  },
  "required": ["stories", "supplements"],
  "additionalProperties": false
}
